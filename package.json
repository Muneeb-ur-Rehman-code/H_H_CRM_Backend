{
  "name": "visa-crm-backend",
  "version": "1.0.0",
  "description": "Visa Consultancy CRM Backend",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "dev": "nodemon server.js",
    "serve:watch": "nodemon dist/server.js",
    "start": "node dist/server.js",
    "start:prod": "npm run build && node dist/server.js",
    "clean": "rimraf dist",
    "clean:build": "npm run clean && npm run build",
    "seed:ceo": "ts-node src/seeders/ceo.seeder.ts",
    "dev:ts": "nodemon --exec ts-node server.ts",
    "dev:debug": "concurrently \"npm run build:watch\" \"npm run serve:debug\"",
    "serve:debug": "nodemon --inspect dist/server.js",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.5.0",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.4",
    "@types/node": "^20.5.0",
    "@types/nodemailer": "^6.4.9",
    "@typescript-eslint/eslint-plugin": "^6.4.0",
    "@typescript-eslint/parser": "^6.4.0",
    "concurrently": "^8.2.0",
    "jest": "^29.6.4",
    "nodemon": "^3.0.1",
    "rimraf": "^5.0.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "tsx": "^3.12.7",
    "typescript": "^5.1.6"
  }
}
